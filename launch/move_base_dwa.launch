<launch>
  <!-- Simple launch wrapper to run move_base with basic costmap and DWA params -->
  <arg name="use_sim_time" default="false"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find spark_noetic)/launch/nav_params/costmap_common.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find spark_noetic)/launch/nav_params/costmap_common.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find spark_noetic)/launch/nav_params/local_costmap.yaml" command="load"/>
    <rosparam file="$(find spark_noetic)/launch/nav_params/dwa_local_planner.yaml" command="load"/>
  </node>
</launch>
